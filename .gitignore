# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data pipeline
#   raw/ and output/ are deliberately committed — see pipeline/README.md.
#   Only fetch scratch files are ignored.
pipeline/**/*.tmp
pipeline/**/*.download
# throwaway source downloads and extraction scratch (e.g. pre-flight inventories)
pipeline/raw/_scratch/

# editor / agent tooling
.claude/

# session scratch
.scratch/

# Regenerable output of pipeline/financial_disclosures/scan_checkbox_form_v2.py
pipeline/financial_disclosures/checkbox_scan_v2_results.json

# Justia extracted lists are local-only until the terms question is settled
/pipeline/preflight/scdb-landmarks/out/
