{
  "name": "congress-ideology",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:all": "pnpm fetch:voteview && pnpm fetch:legislators",
    "fetch:voteview": "tsx pipeline/fetch/voteview.ts",
    "fetch:legislators": "tsx pipeline/fetch/legislators.ts",
    "fetch:photos": "tsx pipeline/fetch/photos.ts",
    "validate": "tsx pipeline/validate/validate.ts",
    "transform": "tsx pipeline/transform/index.ts",
    "pipeline": "pnpm fetch:all && pnpm validate && pnpm transform && pnpm fetch:photos",
    "pipeline:check": "pnpm validate && pnpm transform && git diff --exit-code --stat -- pipeline/output"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "packageManager": "pnpm@10.34.5"
}
